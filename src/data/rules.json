{
  "meta": {
    "version": "0.1.0-draft",
    "status": "DRAFT",
    "reviewedBy": null,
    "disclaimer": "ReadyToPlay does not replace a doctor. Only a doctor can clear you to play.",
    "estimatePolicy": "Every estimate starts at maxDays (the conservative end) and the full range is shown. Improving check-ins can move it toward minDays but never below it. Getting worse never moves it earlier."
  },
  "actions": {
    "see_care_today": {
      "title": "Get it checked today",
      "message": "Stop playing. This needs a real check before a recovery plan. We'll show you where to go."
    },
    "see_trainer": {
      "title": "Get it checked first",
      "message": "This might need a brace, splint, or exam. Your plan starts once a doctor has looked at it."
    },
    "plan": {
      "title": "You can start a recovery plan",
      "message": "No warning signs found. Follow the plan and do your daily check-in."
    }
  },
  "globalRedFlags": [],
  "otherPain": {
    "action": "see_trainer",
    "message": "We only build plans for ankle, shoulder, hamstring, and wrist injuries. For anything else, answer the warning-sign questions and we'll point you to the right care.",
    "useGlobalRedFlags": true
  },
  "checkInRules": [
    {
      "id": "new_numbness_or_spike",
      "question": "Since yesterday, any new numbness or tingling, or a sudden jump in pain or swelling?",
      "triggerAnswer": true,
      "action": "see_care_today",
      "sources": [
        "medline_hamstring",
        "medline_wrist"
      ]
    },
    {
      "id": "worse_two_days",
      "rule": "Pain score higher than the day before on 2 check-ins in a row",
      "action": "see_trainer",
      "sources": [
        "plan"
      ]
    }
  ],
  "selfTestScoring": {
    "painScale": "0 = no pain, 10 = worst pain imaginable",
    "rules": [
      {
        "if": "pain >= 7 OR any function test failed",
        "severity": "see_someone"
      },
      {
        "if": "pain 4-6 OR any function test 'with difficulty'",
        "severity": "moderate"
      },
      {
        "if": "pain <= 3 AND all function tests passed",
        "severity": "mild"
      }
    ],
    "swellingRule": "Swelling 'A lot' counts the same as a function test answered 'With difficulty'."
  },
  "phaseTemplate": [
    {
      "id": "protect",
      "name": "Protect & calm it down",
      "shareOfTimeline": 0.15
    },
    {
      "id": "motion",
      "name": "Gentle movement",
      "shareOfTimeline": 0.25
    },
    {
      "id": "strength",
      "name": "Build strength",
      "shareOfTimeline": 0.3
    },
    {
      "id": "sport",
      "name": "Sport drills",
      "shareOfTimeline": 0.3
    },
    {
      "id": "return",
      "name": "Return to play (doctor clears you)",
      "shareOfTimeline": 0
    }
  ],
  "rice": {
    "rest": "Stop the activity that hurt it. Use crutches for a leg injury if walking hurts.",
    "ice": "Cold pack wrapped in a towel for 20 minutes, a few times a day. Never put ice right on skin.",
    "compression": "Elastic wrap, snug but not tight.",
    "elevation": "Keep it raised above your heart when resting.",
    "sources": [
      "aaos_soft_tissue",
      "medline_hamstring"
    ]
  },
  "injuries": {
    "ankle": {
      "name": "Ankle sprain",
      "askSide": true,
      "locationQuestion": "Where does it hurt most?",
      "locations": [
        {
          "id": "outside",
          "label": "Outside of the ankle",
          "hint": "Your foot rolled inward. This is the most common sprain.",
          "effect": "standard",
          "sources": [
            "cleveland_ankle",
            "statpearls_ankle"
          ]
        },
        {
          "id": "high",
          "label": "Above the ankle, front of the lower leg",
          "hint": "Your foot got twisted outward, often in a collision. Hurts more when you turn your foot out.",
          "effect": "estimate_override",
          "estimates": {
            "mild": {
              "minDays": 42,
              "maxDays": 56,
              "label": "Possible high ankle sprain"
            },
            "moderate": {
              "minDays": 42,
              "maxDays": 84,
              "label": "Possible high ankle sprain"
            }
          },
          "alsoAction": "see_trainer",
          "note": "High ankle sprains usually take 6-8 weeks or longer, about twice as long as a normal sprain. Get a doctor to confirm.",
          "sources": [
            "cleveland_high_ankle",
            "pmc_ankle_athlete"
          ]
        },
        {
          "id": "inside",
          "label": "Inside of the ankle",
          "hint": "Your foot rolled outward.",
          "effect": "estimate_override",
          "note": "Inside-ankle sprains are less common and usually take longer than outside ones. Have a doctor confirm it.",
          "alsoAction": "see_trainer",
          "estimates": {
            "mild": {
              "minDays": 21,
              "maxDays": 35,
              "label": "Inside ankle sprain"
            },
            "moderate": {
              "minDays": 35,
              "maxDays": 56,
              "label": "Inside ankle sprain"
            }
          },
          "sources": [
            "cleveland_high_ankle"
          ]
        }
      ],
      "redFlags": [
        {
          "id": "ottawa_weight",
          "question": "Can you take 4 steps on it right now? (Limping is OK.)",
          "triggerAnswer": false,
          "action": "see_care_today",
          "note": "Not being able to take 4 steps can mean a broken bone, so it needs an X-ray.",
          "sources": [
            "aafp_ankle_2012"
          ]
        },
        {
          "id": "ottawa_bone",
          "question": "Press gently on the back edge and tip of the ankle bones on both sides, the bump on the outside middle of your foot, and the bump on the inside middle of your foot. Does it hurt right on the bone?",
          "triggerAnswer": true,
          "action": "see_care_today",
          "note": "Pain right on the bone can mean a fracture, so it needs an X-ray.",
          "sources": [
            "aafp_ankle_2012"
          ]
        }
      ],
      "selfTests": [
        {
          "id": "pain",
          "type": "scale",
          "question": "How bad is the pain right now? (0-10)"
        },
        {
          "id": "walk",
          "type": "function",
          "question": "Can you walk normally across the room?",
          "options": [
            "Yes",
            "With difficulty",
            "No"
          ]
        },
        {
          "id": "rom",
          "type": "function",
          "question": "Can you point your toes up and down and draw circles with your foot?",
          "options": [
            "Yes",
            "With difficulty",
            "No"
          ]
        },
        {
          "id": "swelling",
          "type": "choice",
          "question": "How swollen is it?",
          "options": [
            "None",
            "A little",
            "A lot"
          ]
        }
      ],
      "estimates": {
        "mild": {
          "minDays": 7,
          "maxDays": 14,
          "label": "Mild sprain (like a grade 1)"
        },
        "moderate": {
          "minDays": 21,
          "maxDays": 42,
          "label": "Moderate (like a grade 2)"
        },
        "see_someone": {
          "action": "see_care_today",
          "note": "Possible grade 3 (complete tear): 6-12 weeks and sometimes surgery. Not planned by the app."
        }
      },
      "trainerCheckDay": {
        "minDay": 4,
        "maxDay": 7,
        "reason": "Exams are more accurate 4-7 days after the injury."
      },
      "phases": {
        "protect": [
          "RICE",
          "Brace or wrap for about 5-10 days",
          "Start gentle range-of-motion in the first week"
        ],
        "motion": [
          "Ankle alphabet (trace letters with your toes)",
          "Resistance-band up/down/in/out",
          "Walk as pain allows"
        ],
        "strength": [
          "Single-leg balance 30-60 seconds",
          "Calf raises",
          "One-leg mini squats",
          "Wobble board if available"
        ],
        "sport": [
          "Scissor hops",
          "Squat jumps",
          "Bounding at half speed",
          "Sport-specific cutting drills"
        ],
        "return": [
          "A doctor clears you",
          "Wear a lace-up or semi-rigid brace during sports (recommended for up to 12 months)"
        ]
      },
      "noImprovementDays": 7,
      "sources": [
        "statpearls_ankle",
        "aafp_ankle_2012",
        "aafp_ankle_2025",
        "cleveland_ankle"
      ]
    },
    "shoulder": {
      "name": "Shoulder strain / overuse pain",
      "askSide": true,
      "locationQuestion": "Where does it hurt most?",
      "locations": [
        {
          "id": "outer",
          "label": "Outer side of the shoulder",
          "hint": "Worse when you lift your arm out to the side or overhead.",
          "effect": "standard",
          "sources": [
            "aaos_rotator_cuff",
            "cleveland_shoulder"
          ]
        },
        {
          "id": "front",
          "label": "Front of the shoulder",
          "hint": "Can spread down the front of your arm.",
          "effect": "standard",
          "sources": [
            "cleveland_shoulder"
          ]
        },
        {
          "id": "top",
          "label": "Top of the shoulder",
          "hint": "Often after falling on your shoulder or getting hit on it.",
          "effect": "estimate_override",
          "note": "Pain on top after a fall or hit can be a shoulder separation (AC joint). Mild ones heal in about 2 weeks, worse ones take 6-8 weeks or more, and only an exam can tell which. A bump on top means see care today.",
          "alsoAction": "see_trainer",
          "estimates": {
            "mild": {
              "minDays": 14,
              "maxDays": 21,
              "label": "Mild shoulder separation (AC joint)"
            },
            "moderate": {
              "action": "see_trainer",
              "note": "Moderate separations can take 6-8 weeks or more. A doctor sets the timeline."
            }
          },
          "sources": [
            "cleveland_separated",
            "hopkins_ac"
          ]
        }
      ],
      "redFlags": [
        {
          "id": "sudden_weak",
          "question": "Did it start suddenly with a snap, and now your arm feels weak?",
          "triggerAnswer": true,
          "action": "see_care_today",
          "note": "Sudden snap plus immediate weakness can mean a rotator cuff tear.",
          "sources": [
            "hopkins_rotator_cuff",
            "aaos_rotator_cuff"
          ]
        },
        {
          "id": "cant_lift",
          "question": "Can you raise your arm out to the side and over your head?",
          "triggerAnswer": false,
          "action": "see_care_today",
          "sources": [
            "aaos_rotator_cuff"
          ]
        },
        {
          "id": "night_pain",
          "question": "Does it hurt at night or wake you up?",
          "triggerAnswer": true,
          "action": "see_trainer",
          "sources": [
            "aaos_rotator_cuff",
            "cleveland_shoulder"
          ]
        },
        {
          "id": "fever_red",
          "question": "Do you have a fever, or is the shoulder red and hot?",
          "triggerAnswer": true,
          "action": "see_care_today",
          "note": "Possible infection.",
          "sources": [
            "cleveland_shoulder"
          ]
        }
      ],
      "selfTests": [
        {
          "id": "pain",
          "type": "scale",
          "question": "How bad is the pain right now? (0-10)"
        },
        {
          "id": "overhead",
          "type": "function",
          "question": "Can you lift your arm straight overhead?",
          "options": [
            "Yes",
            "With difficulty",
            "No"
          ]
        },
        {
          "id": "reach_back",
          "type": "function",
          "question": "Can you reach behind your back like tucking in a shirt?",
          "options": [
            "Yes",
            "With difficulty",
            "No"
          ]
        },
        {
          "id": "daily",
          "type": "function",
          "question": "Can you do everyday things (backpack, brushing hair) without pain?",
          "options": [
            "Yes",
            "With difficulty",
            "No"
          ]
        }
      ],
      "estimates": {
        "mild": {
          "minDays": 14,
          "maxDays": 28,
          "label": "Mild tendinitis / strain"
        },
        "moderate": {
          "action": "see_trainer",
          "note": "More serious cases can take several months. A doctor sets the timeline."
        },
        "see_someone": {
          "action": "see_care_today"
        }
      },
      "phases": {
        "protect": [
          "Rest from throwing and overhead motions",
          "Ice 20 minutes a few times a day",
          "No overhead lifting"
        ],
        "motion": [
          "Pendulum swings",
          "Gentle range-of-motion as pain allows"
        ],
        "strength": [
          "Resistance-band rotator cuff exercises",
          "Shoulder blade squeezes"
        ],
        "sport": [
          "Warm up with flexibility work first",
          "Gradual return to throwing / overhead sport motions"
        ],
        "return": [
          "No pain or symptoms",
          "A doctor clears you"
        ]
      },
      "noImprovementDays": 14,
      "sources": [
        "cleveland_shoulder",
        "hopkins_rotator_cuff",
        "aaos_rotator_cuff"
      ]
    },
    "hamstring": {
      "name": "Hamstring strain",
      "askSide": true,
      "locationQuestion": "Where on the back of your thigh does it hurt most?",
      "locations": [
        {
          "id": "middle",
          "label": "Middle of the back of the thigh",
          "hint": "The most common spot for a pulled hamstring.",
          "effect": "standard",
          "sources": [
            "medline_hamstring",
            "cleveland_hamstring"
          ]
        },
        {
          "id": "upper",
          "label": "High up, near the buttock",
          "hint": "Right where the leg meets the buttock.",
          "effect": "action",
          "action": "see_care_today",
          "note": "Pain this high can mean the tendon is injured or pulled off the bone. Tendon injuries can take months and sometimes need surgery.",
          "sources": [
            "medline_hamstring",
            "pmc_hamstring_tendon"
          ]
        },
        {
          "id": "lower",
          "label": "Low, right behind the knee",
          "hint": "Just above the back of the knee.",
          "effect": "action",
          "action": "see_care_today",
          "note": "Pain close to the knee can mean the tendon pulled off the bone. A doctor should check it.",
          "sources": [
            "medline_hamstring"
          ]
        }
      ],
      "redFlags": [
        {
          "id": "big_bruise",
          "question": "Is there a lot of bruising on the back of your leg?",
          "triggerAnswer": true,
          "action": "see_care_today",
          "note": "Heavy bruising can mean the tendon pulled off the bone.",
          "sources": [
            "medline_hamstring",
            "cleveland_hamstring"
          ]
        },
        {
          "id": "cant_walk",
          "question": "Can you walk without a big limp?",
          "triggerAnswer": false,
          "action": "see_care_today",
          "sources": [
            "cleveland_hamstring"
          ]
        }
      ],
      "selfTests": [
        {
          "id": "pain",
          "type": "scale",
          "question": "How bad is the pain right now? (0-10)"
        },
        {
          "id": "walk",
          "type": "function",
          "question": "Can you walk normally?",
          "options": [
            "Yes",
            "With difficulty",
            "No"
          ]
        },
        {
          "id": "bend_knee",
          "type": "function",
          "question": "Lying on your stomach, can you bend your knee against light resistance?",
          "options": [
            "Yes",
            "With difficulty",
            "No"
          ]
        },
        {
          "id": "stretch",
          "type": "function",
          "question": "Can you gently straighten your leg and lean forward a little?",
          "options": [
            "Yes",
            "With difficulty",
            "No"
          ]
        }
      ],
      "estimates": {
        "mild": {
          "minDays": 7,
          "maxDays": 21,
          "label": "Mild strain (like a grade 1)"
        },
        "moderate": {
          "minDays": 21,
          "maxDays": 42,
          "label": "Moderate (like a grade 2)"
        },
        "see_someone": {
          "action": "see_care_today",
          "note": "Possible grade 3 (complete tear): several months and sometimes surgery."
        }
      },
      "trainerCheckDay": {
        "minDay": 7,
        "maxDay": 14,
        "reason": "MedlinePlus advises a follow-up 1-2 weeks after the injury."
      },
      "phases": {
        "protect": [
          "RICE",
          "Crutches if walking hurts",
          "No stretching yet"
        ],
        "motion": [
          "Light stretching once pain allows",
          "Easy walking"
        ],
        "strength": [
          "Gradual hamstring strengthening"
        ],
        "sport": [
          "Jogging, then build to sprinting",
          "Sport drills"
        ],
        "return": [
          "Same strength and flexibility as the other leg",
          "No pain when sprinting",
          "A doctor clears you"
        ]
      },
      "noImprovementDays": 14,
      "sources": [
        "medline_hamstring",
        "cleveland_hamstring",
        "pmc_hamstring_college",
        "pmc_hamstring_mlb"
      ]
    },
    "wrist": {
      "name": "Wrist sprain",
      "askSide": true,
      "locationQuestion": "Where does it hurt most?",
      "locations": [
        {
          "id": "thumb",
          "label": "Thumb side",
          "hint": "Often after falling on an outstretched hand.",
          "effect": "standard",
          "note": "We'll do an extra check for a hidden broken bone (scaphoid), which is common on this side.",
          "sources": [
            "aafp_scaphoid",
            "aaos_scaphoid"
          ]
        },
        {
          "id": "back",
          "label": "Back or middle of the wrist",
          "hint": "The top of your wrist, above the back of your hand.",
          "effect": "standard",
          "sources": [
            "clevelandclinic_wrist",
            "aaos_wrist"
          ]
        },
        {
          "id": "pinky",
          "label": "Pinky side",
          "hint": "Might click or pop when you turn your wrist.",
          "effect": "estimate_override",
          "note": "Pinky-side pain can be a cartilage injury (TFCC) that heals slower than a normal sprain. Have a doctor confirm it.",
          "alsoAction": "see_trainer",
          "estimates": {
            "mild": {
              "minDays": 21,
              "maxDays": 42,
              "label": "Possible cartilage (TFCC) strain"
            },
            "moderate": {
              "action": "see_trainer",
              "note": "Pinky-side injuries that hurt this much need an exam before a plan."
            }
          },
          "sources": [
            "cleveland_tfcc",
            "pmc_wrist_sports"
          ]
        }
      ],
      "redFlags": [
        {
          "id": "snuffbox",
          "question": "Give a thumbs-up. Press in the little hollow at the base of your thumb on the back of your wrist. Does it hurt there?",
          "triggerAnswer": true,
          "action": "see_care_today",
          "note": "Tenderness here can mean a scaphoid fracture, which is often missed and mistaken for a sprain.",
          "sources": [
            "aafp_scaphoid",
            "aaos_scaphoid"
          ]
        },
        {
          "id": "fingers",
          "question": "Can you move all your fingers and make a fist?",
          "triggerAnswer": false,
          "action": "see_care_today",
          "sources": [
            "clevelandclinic_wrist"
          ]
        },
        {
          "id": "unstable_locking",
          "question": "Does the wrist feel loose, unstable, or like it locks or catches?",
          "triggerAnswer": true,
          "action": "see_care_today",
          "sources": [
            "medline_wrist",
            "clevelandclinic_wrist"
          ]
        }
      ],
      "selfTests": [
        {
          "id": "pain",
          "type": "scale",
          "question": "How bad is the pain right now? (0-10)"
        },
        {
          "id": "bend",
          "type": "function",
          "question": "Can you bend your wrist up and down?",
          "options": [
            "Yes",
            "With difficulty",
            "No"
          ]
        },
        {
          "id": "grip",
          "type": "function",
          "question": "Can you grip a water bottle and twist the cap?",
          "options": [
            "Yes",
            "With difficulty",
            "No"
          ]
        },
        {
          "id": "swelling",
          "type": "choice",
          "question": "How swollen is it?",
          "options": [
            "None",
            "A little",
            "A lot"
          ]
        }
      ],
      "estimates": {
        "mild": {
          "minDays": 14,
          "maxDays": 21,
          "label": "Mild sprain"
        },
        "moderate": {
          "action": "see_trainer",
          "note": "Moderate sprains often need a splint. A doctor sets the plan."
        },
        "see_someone": {
          "action": "see_care_today"
        }
      },
      "noImprovementHours": 48,
      "noImprovementNote": "Pain or swelling that lasts more than 48 hours should be checked, because wrist fractures can hide on early X-rays.",
      "phases": {
        "protect": [
          "RICE",
          "Wrap or brace"
        ],
        "motion": [
          "Gentle wrist bends and circles"
        ],
        "strength": [
          "Grip squeezes",
          "Light wrist curls"
        ],
        "sport": [
          "Catching, passing, and weight-bearing drills (push-up position) only when pain-free"
        ],
        "return": [
          "Full pain-free motion and grip",
          "A doctor clears you"
        ]
      },
      "sources": [
        "clevelandclinic_wrist",
        "aaos_wrist",
        "medline_wrist",
        "aafp_scaphoid"
      ]
    }
  },
